+      finish({ ok: false, installed: false, error: String(error && error.message ? error.message : error) });
+    });
+    child.on("close", (code) => {
+      if (code === 0) {
+        finish({ ok: true, installed: true });
+      } else {
+        finish({
+          ok: false,
+          installed: false,
+          error: (tail.trim() || `npm install exited ${code}`).split("\n").slice(-3).join(" "),
