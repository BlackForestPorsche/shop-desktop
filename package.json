{
  "name": "blackforest-tools",
  "productName": "Black Forest Tools",
  "version": "1.5.15",
  "private": true,
  "description": "Desktop window for the Black Forest Automotive shop tools site.",
  "main": "src/main.js",
  "author": "Black Forest Automotive",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall-electron.js && node scripts/postinstall-labels.js",
    "start": "electron .",
    "test": "node --test",
    "install-menu": "bash scripts/install-manjaro.sh",
    "install-plasma": "bash scripts/install-plasma-widget.sh",
    "install-windows": "powershell -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "bootstrap-windows": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-windows.ps1",
    "enable-autostart": "bash scripts/enable-tools-autostart.sh",
    "disable-autostart": "bash scripts/disable-tools-autostart.sh",
    "firefox-signed-in": "bash scripts/open-firefox-signed-in.sh",
    "ensure-icon": "node scripts/ensure-icon.js",
    "dist": "npm run ensure-icon && electron-builder --linux AppImage",
    "dist:win": "npm run ensure-icon && electron-builder --win",
    "ensure-labels": "bash scripts/ensure-labels.sh",
    "sync-labels": "bash scripts/sync-labels-vendor.sh"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.blackforestautomotive.tools",
    "productName": "Black Forest Tools",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "labels/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Black Forest Tools"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
