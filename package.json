{
  "name": "blackforest-tools",
  "productName": "Black Forest Tools",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop window for the Black Forest Automotive shop tools site.",
  "main": "src/main.js",
  "author": "Black Forest Automotive",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall-electron.js",
    "start": "electron .",
    "test": "node --test",
    "install-menu": "bash scripts/install-manjaro.sh",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.blackforestautomotive.tools",
    "productName": "Black Forest Tools",
    "executableName": "BlackForestTools",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "assets/icon.png",
      "synopsis": "Live window for the Black Forest shop tools",
      "maintainer": "Black Forest Automotive",
      "executableName": "blackforest-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Black Forest Tools",
      "uninstallDisplayName": "Black Forest Tools",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
